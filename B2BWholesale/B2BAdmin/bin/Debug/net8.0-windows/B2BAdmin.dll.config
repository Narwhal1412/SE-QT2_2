<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <connectionStrings>
    <!-- Change Server to your SQL Server instance (e.g. .\SQLEXPRESS or localhost) -->
    <add name="B2BWholesaleDb"
         connectionString="Server=(localdb)\MSSQLLocalDB;Database=B2BWholesaleDB;Integrated Security=True;TrustServerCertificate=True;"
         providerName="Microsoft.Data.SqlClient" />
  </connectionStrings>
  <appSettings>
    <add key="LowStockThreshold" value="20" />
    <add key="MaxLoginAttempts" value="5" />
  </appSettings>
</configuration>
