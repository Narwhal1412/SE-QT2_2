@page
@model B2BAgentPortal.Pages.OrdersModel
@{ ViewData["Title"] = "My Orders"; }

<h2><i class="bi bi-receipt"></i> My Orders</h2>

@if (!Model.Orders.Any())
{
    <p class="text-muted">You have no orders yet.</p>
}
else
{
    <div class="table-responsive">
    <table class="table table-striped align-middle">
        <thead>
            <tr><th>Order #</th><th>Date</th><th>Status</th><th class="text-end">Total (VND)</th><th></th></tr>
        </thead>
        <tbody>
        @foreach (var o in Model.Orders)
        {
            var badge = o.OrderStatus switch
            {
                "Pending" => "bg-secondary",
                "Processing" => "bg-info text-dark",
                "Shipped" => "bg-primary",
                "Delivered" => "bg-success",
                _ => "bg-danger"                      // Cancelled
            };
            <tr>
                <td>@o.OrderId</td>
                <td>@o.OrderDate.ToString("dd/MM/yyyy HH:mm")</td>
                <td><span class="badge @badge">@o.OrderStatus</span></td>
                <td class="text-end">@o.OrderDetails.Sum(d => d.Quantity * d.UnitAmount).ToString("N0")</td>
                <td class="text-end">
                    <a asp-page="/Invoice" asp-route-id="@o.OrderId" class="btn btn-sm btn-outline-primary">
                        <i class="bi bi-printer"></i> Invoice
                    </a>
                </td>
            </tr>
        }
        </tbody>
    </table>
    </div>
}